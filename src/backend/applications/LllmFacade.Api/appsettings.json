{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "InitialUserName": "admin",
    "InitialPassword": "admin",
    "LoginAttemptsPerMinute": 10,
    "RequireHttpsCookie": false
  },
  "Workers": {
    "Enabled": true,
    "RefreshScanSeconds": 60
  },
  "Autopilot": {
    "PollIntervalSeconds": 300,
    "RetryIntervalSeconds": 60,
    "SubmissionGraceSeconds": 300,
    "CompletionPauseMinutes": 10,
    "ChallengeCooldownMinutes": 30,
    "RateLimitCooldownMinutes": 15,
    "RepeatedRateLimitCooldownMinutes": 30,
    "RateLimitRepeatWindowMinutes": 30,
    "RateLimitReleaseStaggerSeconds": 30,
    "RateLimitReleaseStaggerMaxSeconds": 300,
    "ScanIntervalSeconds": 5,
    "MaxParallelProjects": 4
  },
  "Browser": {
    "Headless": true,
    "MaxPagesPerEndpoint": 3,
    "MaxTabsPerEndpoint": 24,
    "PageLoadToPromptDelayMilliseconds": 120000,
    "PromptToSendDelayMilliseconds": 8000,
    "MinimumPromptSendIntervalMilliseconds": 60000,
    "NavigationTimeoutSeconds": 60,
    "ConfirmationTimeoutSeconds": 60,
    "CompletionTimeoutMinutes": 30
  },
  "ChatGpt": {
    "BaseUrl": "https://chatgpt.com"
  }
}
