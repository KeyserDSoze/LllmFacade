# Copiare in .env (non versionato) e cambiare i valori prima di `docker compose up`.
# Usare una password senza ';' perché finisce nella connection string.
POSTGRES_PASSWORD=cambia-questa-password
LLLMFACADE_PORT=8080
# true solo dietro un reverse proxy HTTPS: il cookie di sessione admin diventa Secure.
LLLMFACADE_HTTPS_COOKIE=false
